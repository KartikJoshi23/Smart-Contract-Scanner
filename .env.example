# =================================
# Smart Contract Scanner - Environment Variables
# =================================
# Copy this file to backend/.env and fill in your actual API keys

# Database
DATABASE_URL=sqlite:///./contract_scanner.db

# Gemini API (required for AI analysis)
# Get your key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Alchemy API (required for fetching contracts from blockchain)
# Get your key at: https://dashboard.alchemy.com/
ALCHEMY_API_KEY=your_alchemy_api_key_here

# App Configuration
DEBUG=true
LOG_LEVEL=INFO
